{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wanji02/aca/blob/main/skills/aca-connect/references/connection.schema.json",
  "title": "ACA local connection record 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_version", "connection_id", "target", "environment", "capabilities", "credential_refs", "lifecycle", "limitations"],
  "properties": {
    "record_version": {"const": "1.0.0"},
    "connection_id": {"$ref": "#/$defs/id"},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "name", "identity_ref"],
      "properties": {
        "kind": {"enum": ["application", "platform", "device", "service"]},
        "name": {"$ref": "#/$defs/text"},
        "identity_ref": {"$ref": "#/$defs/text"}
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["context_revision", "host", "adapter_version", "target_version"],
      "properties": {
        "context_revision": {"$ref": "#/$defs/id"},
        "host": {"$ref": "#/$defs/nullableText"},
        "adapter_version": {"$ref": "#/$defs/nullableText"},
        "target_version": {"$ref": "#/$defs/nullableText"}
      }
    },
    "capabilities": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {"$ref": "#/$defs/capability"}
    },
    "credential_refs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "start", "health_check", "recover", "stop", "owned_resources"],
      "properties": {
        "mode": {"enum": ["on_demand", "persistent", "external"]},
        "start": {"$ref": "#/$defs/nullableText"},
        "health_check": {"$ref": "#/$defs/nullableText"},
        "recover": {"$ref": "#/$defs/nullableText"},
        "stop": {"$ref": "#/$defs/nullableText"},
        "owned_resources": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
      },
      "allOf": [{
        "if": {"properties": {"mode": {"const": "persistent"}}},
        "then": {"properties": {
          "start": {"$ref": "#/$defs/text"},
          "health_check": {"$ref": "#/$defs/text"},
          "stop": {"$ref": "#/$defs/text"},
          "owned_resources": {"type": "array", "minItems": 1}
        }}
      }]
    },
    "limitations": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/text"}},
    "extensions": {
      "type": "object", "maxProperties": 32,
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]*[.][a-z][a-z0-9_.-]*$"},
      "additionalProperties": true
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\S"},
    "nullableText": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
    "entryPoint": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "reference", "input_description"],
      "properties": {
        "kind": {"enum": ["host_tool", "command", "http", "manual"]},
        "reference": {"$ref": "#/$defs/text"},
        "input_description": {"$ref": "#/$defs/text"}
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "context_revision", "checked_at", "method", "observed_result", "evidence_refs"],
      "properties": {
        "scope": {"enum": ["fixture", "real_target"]},
        "context_revision": {"$ref": "#/$defs/id"},
        "checked_at": {"type": "string", "format": "date-time", "maxLength": 64},
        "method": {"enum": ["response_inspection", "state_readback", "physical_observation", "recipient_confirmation", "combined"]},
        "observed_result": {"$ref": "#/$defs/text"},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
      }
    },
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "status", "entry_point", "verification"],
      "properties": {
        "name": {"$ref": "#/$defs/id"},
        "status": {"enum": ["needs_setup", "verified", "partial", "unsupported", "failed", "unknown"]},
        "entry_point": {"anyOf": [{"$ref": "#/$defs/entryPoint"}, {"type": "null"}]},
        "verification": {"anyOf": [{"$ref": "#/$defs/verification"}, {"type": "null"}]}
      },
      "allOf": [{
        "if": {"properties": {"status": {"enum": ["verified", "partial"]}}},
        "then": {"properties": {
          "entry_point": {"$ref": "#/$defs/entryPoint"},
          "verification": {"$ref": "#/$defs/verification"}
        }}
      }]
    }
  }
}
